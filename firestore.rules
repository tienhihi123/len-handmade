rules_version = '2';

// ============================================================
// Staff/Admin Control Panel RBAC (9 staff roles + storefront customers).
// Admin checks are validated directly against the staff/{uid} document —
// no Cloud Functions / custom claims / Blaze plan required. Deployable
// as-is via `firebase deploy --only firestore:rules`.
//
// Bootstrap: the very first admin doc can't be created by the client
// (no admin exists yet to satisfy `isAdmin()`), so create it once by hand
// in the Firebase Console: collection `staff`, document id = your
// Firebase Auth uid, fields `{ roleId: "admin", status: "active" }`.
// After that, isAdmin() can grant further staff writes from the app.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------- Helpers ----------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Doc-only check (no custom claims): the staff/{uid} document is the
    // sole source of truth for who's staff and what role they hold.
    function staffDocFor(uid) {
      return get(/databases/$(database)/documents/staff/$(uid)).data;
    }

    function isActiveStaffWithRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDocFor(request.auth.uid).roleId == role
        && staffDocFor(request.auth.uid).status == 'active';
    }

    function isAnyActiveStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDocFor(request.auth.uid).status == 'active';
    }

    function isAdmin() { return isActiveStaffWithRole('admin'); }
    function isStoreManager() { return isActiveStaffWithRole('store_manager'); }
    function isProductManager() { return isActiveStaffWithRole('product_inventory_manager'); }
    function isOrderOps() { return isActiveStaffWithRole('order_operations'); }
    function isSupport() { return isActiveStaffWithRole('customer_support'); }
    function isMarketing() { return isActiveStaffWithRole('content_marketing_manager'); }
    function isReviewMod() { return isActiveStaffWithRole('review_moderator'); }
    function isFinance() { return isActiveStaffWithRole('finance_reporting'); }
    function isAuditor() { return isActiveStaffWithRole('auditor'); }

    function canManageCatalog() { return isAdmin() || isStoreManager() || isProductManager(); }
    function canReadFinance() { return isAdmin() || isFinance() || isAuditor(); }
    function canReadOrdersBroad() {
      return isAdmin() || isStoreManager() || isOrderOps() || isSupport() || isFinance() || isAuditor();
    }

    // Legal order status transition graph — no arbitrary status jumps.
    function allowedNextStatuses(status) {
      return status == 'pending_payment' ? ['payment_confirmed', 'cancelled', 'cancel_requested'] :
        status == 'payment_confirmed' ? ['processing', 'cancel_requested'] :
        status == 'processing' ? ['ready_to_ship', 'cancel_requested'] :
        status == 'ready_to_ship' ? ['shipping', 'cancel_requested'] :
        status == 'shipping' ? ['delivered', 'return_requested'] :
        status == 'delivered' ? ['completed', 'return_requested'] :
        status == 'cancel_requested' ? ['cancelled', 'processing'] :
        status == 'return_requested' ? ['return_approved', 'completed'] :
        status == 'return_approved' ? ['returned'] :
        status == 'returned' ? ['refund_pending'] :
        status == 'refund_pending' ? ['refunded'] :
        [];
    }

    function isValidOrderTransition() {
      return incoming().status == existing().status
        || incoming().status in allowedNextStatuses(existing().status);
    }

    // Khách báo "Tôi đã chuyển khoản": CHỈ được đổi đúng 3 field, và chỉ được
    // đi từ unpaid -> pending_confirmation (đơn cũ thiếu field hiểu là unpaid).
    function isCustomerPaymentReport() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'paymentReportedAt', 'updatedAt'])
        && existing().get('paymentStatus', 'unpaid') == 'unpaid'
        && incoming().paymentStatus == 'pending_confirmation';
    }

    // ---------------- users/{uid} (storefront customers) ----------------
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'status'])
        && data.keys().size() <= 12
        && data.role == 'customer'
        && data.status in ['active', 'locked'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSupport();
      allow create: if isOwner(userId) && incoming().role == 'customer' && incoming().status == 'active' && isValidUser(incoming());
      allow update: if (isOwner(userId) && incoming().role == existing().role && incoming().status == existing().status && isValidUser(incoming())) || isAdmin();
      allow delete: if isAdmin();

      match /cart/{itemId} { allow read, write: if isOwner(userId); }
      match /wishlist/{productId} { allow read, write: if isOwner(userId); }
      match /orders/{orderId} {
        allow read: if isOwner(userId) || canReadOrdersBroad();
        // Đơn mới phải thuộc đúng chủ và bắt đầu ở trạng thái chưa thanh toán
        allow create: if isOwner(userId)
          && incoming().userId == userId
          && incoming().get('paymentStatus', 'unpaid') == 'unpaid';
        // Khách CHỈ được thực hiện transition "báo đã chuyển khoản" — không sửa
        // items/total/status/userId. Staff-side dùng status tiếng Việt tự do
        // (transition graph V2 chưa áp dụng — xem ghi chú allowedNextStatuses).
        allow update: if (isOwner(userId) && isCustomerPaymentReport()) || canReadOrdersBroad();
        allow delete: if isAdmin();
      }

      // Nhật ký hoạt động — CHỈ để hiển thị lịch sử cho khách xem lại, KHÔNG phải
      // audit bảo mật. Đọc: chỉ chính chủ. Ghi: chính chủ HOẶC staff (vd admin hủy
      // đơn hộ khách vẫn cần ghi log vào đúng activityLogs của khách). Append-only —
      // không cho sửa/xoá.
      match /activityLogs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) || isAnyActiveStaff();
        allow update, delete: if false;
      }

      // Biến động số dư/Xu — Phase B: CHỈ đọc. Không client nào (kể cả chính chủ
      // hay staff) được ghi trực tiếp — earn/refund/adjustment cần trusted backend
      // (Cloud Function) ở phase sau, chưa tồn tại.
      match /walletTransactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ---------------- staff/{uid} ----------------
    match /staff/{uid} {
      allow read: if isOwner(uid);
      // Only an existing admin can add/edit staff. The very first admin
      // doc is bootstrapped by hand in the Firebase Console (see header).
      allow write: if isAdmin();
    }

    // ---------------- roles/{roleId} — static reference data ----------------
    match /roles/{roleId} {
      allow read: if isAnyActiveStaff();
      allow write: if false; // shipped with the app, not runtime-editable
    }

    // ---------------- auditLogs/{id} — append-only, server-written ----------------
    match /auditLogs/{id} {
      allow read: if isAdmin() || isAuditor();
      allow write: if false; // every privileged Cloud Function appends via Admin SDK
    }

    // ---------------- categories/{id} ----------------
    match /categories/{categoryId} {
      allow read: if true; // public storefront
      allow write: if canManageCatalog();
    }

    // ---------------- products/{id} ----------------
    match /products/{productId} {
      allow read: if true; // public storefront catalog (client filters by status)
      allow create, update: if canManageCatalog();
      // Never delete a product that has appeared in an order — Cloud Function
      // deleteProduct enforces the order-history check server-side; direct
      // client deletes are always denied.
      allow delete: if false;

      match /reviews/{reviewId} {
        // Đọc: xem match /{path=**}/reviews/{reviewId} riêng bên dưới (bắt buộc
        // dùng recursive wildcard để collectionGroup("reviews") — dùng bởi
        // "Đánh giá của tôi" — được Firestore chứng minh an toàn ở mọi productId,
        // không chỉ path cụ thể này).
        allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
        allow update: if isAdmin() || isReviewMod();
        allow delete: if isAdmin() || isReviewMod();
      }
    }

    // ---------------- reviews (collection group đọc) ----------------
    // collectionGroup("reviews") (dùng bởi subscribeToMyReviews — tab "Đánh giá
    // của tôi", đọc mọi sản phẩm cùng lúc) cần rule khai báo bằng recursive
    // wildcard match /{path=**}/... để Firestore chứng minh mọi document trong
    // collection group đều thoả rule, bất kể nằm dưới productId nào. Rule lồng
    // cố định products/{productId}/reviews/{reviewId} chỉ áp dụng cho query trực
    // tiếp subcollection (biết trước productId), KHÔNG tự động mở rộng cho
    // collection-group "list" — đây chính là nguyên nhân permission-denied.
    match /{path=**}/reviews/{reviewId} {
      allow read: if existing().status == 'approved' || isAdmin() || isReviewMod() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // ---------------- productVariants/{id} ----------------
    match /productVariants/{variantId} {
      allow read: if true; // public storefront (client filters by product status)
      allow create, delete: if canManageCatalog();
      // update: catalog team toàn quyền; staff active chỉnh stock (hoàn kho khi
      // hủy đơn); KHÁCH chỉ được GIẢM stockQuantity (trừ kho lúc checkout) và
      // chỉ trong 3 field stock/status/updatedAt — không sửa giá hay thông tin khác.
      allow update: if canManageCatalog()
        || (isAnyActiveStaff()
            && incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'status', 'updatedAt']))
        || (
          isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'status', 'updatedAt'])
          && incoming().stockQuantity is int
          && incoming().stockQuantity >= 0
          && incoming().stockQuantity < existing().stockQuantity
        );
    }

    // ---------------- inventory ----------------
    match /inventory/{sku} {
      allow read: if isAdmin() || isProductManager() || isStoreManager() || isAuditor();
      // Small manual tweaks may go direct; anything larger than 20 units
      // must go through the adjustInventory Cloud Function instead.
      allow write: if (isAdmin() || isProductManager())
        && (!('stockQuantity' in existing()) || !('stockQuantity' in incoming())
            || (incoming().stockQuantity - existing().stockQuantity <= 20
                && existing().stockQuantity - incoming().stockQuantity <= 20));
    }

    match /inventoryTransactions/{id} {
      allow read: if isAdmin() || isProductManager() || isStoreManager() || isAuditor();
      // Khách chỉ được ghi log 'sale' (đi kèm transaction trừ kho lúc checkout);
      // staff active ghi log vận hành (restock/return/adjustment).
      allow create: if isAnyActiveStaff() || (isSignedIn() && incoming().changeType == 'sale');
      allow update, delete: if false; // append-only ledger
    }

    // ---------------- orders (top-level, ghi song song với users/{uid}/orders) ----------------
    // Checkout client ghi đồng thời cả hai nơi trong một transaction. Khách chỉ
    // được tạo/đọc/báo-chuyển-khoản đơn CỦA MÌNH; staff đọc và vận hành mọi đơn.
    // Lưu ý: status dùng giá trị tiếng Việt hiện có của LoggedOrder — transition
    // graph allowedNextStatuses() (OrderStatusV2) chưa áp dụng cho model này.
    match /orders/{orderId} {
      allow read: if canReadOrdersBroad() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().get('paymentStatus', 'unpaid') == 'unpaid';
      allow update: if (
          isSignedIn()
          && existing().userId == request.auth.uid
          && incoming().userId == existing().userId
          && isCustomerPaymentReport()
        ) || canReadOrdersBroad();
      allow delete: if false;
    }

    // ---------------- shopNotifications — khách báo chuyển khoản cho shop ----------------
    // Document ID xác định: payment_reported_{orderId} — không thể spam trùng.
    // Khách chỉ tạo/cập nhật notification cho ĐƠN CỦA MÌNH, amount phải khớp
    // totalPrice của đơn, luôn read == false (chỉ staff được đánh dấu đã đọc).
    match /shopNotifications/{notificationId} {
      allow read: if isAnyActiveStaff();
      allow create, update: if isAnyActiveStaff()
        || (
          isSignedIn()
          && incoming().type == 'payment_reported'
          && incoming().userId == request.auth.uid
          && incoming().read == false
          && notificationId == 'payment_reported_' + incoming().orderId
          && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid
          && incoming().amount == get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.totalPrice
        );
      allow delete: if isAdmin();
    }

    // ---------------- payments — Cloud Functions only ----------------
    match /payments/{id} {
      allow read: if canReadFinance();
      allow write: if false; // updatePaymentStatus Cloud Function only
    }

    // ---------------- returns ----------------
    function isValidReturnRequest(data) {
      return data.keys().hasAll(['id', 'orderId', 'productName', 'reason', 'status', 'createdAt'])
        && data.status == 'Chờ xử lý';
    }
    match /returns/{returnId} {
      allow read: if isAdmin() || isSupport() || isStoreManager() || isAuditor() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn() && isValidReturnRequest(incoming());
      allow update: if isAdmin(); // approve/reject reserved for Admin per role spec
      allow delete: if isAdmin();
    }

    // ---------------- refundRequests — approval gated by amount ----------------
    match /refundRequests/{id} {
      allow read: if isAdmin() || isFinance() || isAuditor() || (isSupport() && existing().requestedBy == request.auth.uid);
      allow create: if isSupport() || isAdmin();
      // >=500,000đ only Admin/Finance may move a request to approved/completed —
      // mirrored here from processRefund's server-side idempotency + role check.
      allow update: if (isAdmin() || isFinance())
        || (isSupport() && incoming().amount < 500000 && incoming().status in ['reviewing', 'rejected']);
      allow delete: if false;
    }

    // ---------------- customers (admin-facing profile mirror) ----------------
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isStoreManager() || isSupport() || isFinance() || isAuditor();
      allow update: if isAdmin() || isStoreManager();
      allow create: if isOwner(uid);
      allow delete: if isAdmin();
    }

    // ---------------- points ----------------
    match /pointsTransactions/{id} {
      allow read: if isAdmin() || isFinance() || isSupport() || isAuditor() || (isSignedIn() && existing().userId == request.auth.uid);
      allow write: if false; // adjustPoints Cloud Function only
    }

    // ---------------- coupons ----------------
    match /coupons/{code} {
      allow read: if true; // needed for client-side checkout code validation
      allow write: if isAdmin() || isStoreManager() || isMarketing();
    }

    // ---------------- feedback / support tickets ----------------
    function isValidFeedback(data) {
      return data.keys().hasAll(['userId', 'userName', 'userEmail', 'message', 'status'])
        && data.status == 'new';
    }
    match /feedback/{feedbackId} {
      allow read: if isAdmin() || isSupport() || isReviewMod() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidFeedback(incoming());
      allow update: if isAdmin() || isSupport();
      allow delete: if isAdmin();
    }

    match /supportTickets/{id} {
      allow read: if isAdmin() || isSupport() || isAuditor()
        || (isSignedIn() && existing().customerUid == request.auth.uid);
      allow create: if isAdmin() || isSupport()
        || (isSignedIn() && incoming().customerUid == request.auth.uid);
      // Customers may update their own ticket doc too — sendTicketMessage
      // patches lastMessage/updatedAt/status from either side of the chat.
      allow update: if isAdmin() || isSupport()
        || (isSignedIn() && existing().customerUid == request.auth.uid);
      allow delete: if isAdmin() || isSupport();

      // Two-way ticket chat — append-only, readable/writable by the
      // assigned support staff or the ticket's own customer.
      match /messages/{messageId} {
        allow read: if isAdmin() || isSupport() || isAuditor()
          || (isSignedIn() && get(/databases/$(database)/documents/supportTickets/$(id)).data.customerUid == request.auth.uid);
        allow create: if isAdmin() || isSupport()
          || (isSignedIn() && get(/databases/$(database)/documents/supportTickets/$(id)).data.customerUid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ---------------- blog / banners / notifications ----------------
    match /blogPosts/{id} {
      allow read: if existing().status == 'published' || isAdmin() || isMarketing();
      allow write: if isAdmin() || isMarketing();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin() || isMarketing();
    }

    match /notifications/{id} {
      allow read: if isAnyActiveStaff() || (isSignedIn() && existing().userId == request.auth.uid);
      allow create: if isAnyActiveStaff();
      allow update, delete: if isAdmin();
    }

    // ---------------- settings ----------------
    match /settings/{docId} {
      allow read: if isAnyActiveStaff();
      allow write: if isAdmin();
    }
  }
}
